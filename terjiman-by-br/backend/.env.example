# ---------------------------------------------------------------------------
# Terjiman by BR — backend configuration
# Copy to .env and fill in. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# AI provider: openai | anthropic | mock  ("mock" is for local tests only)
AI_PROVIDER=openai

# Model id for the chosen provider. Leave empty to use the provider default
# (openai -> gpt-4o, anthropic -> claude-sonnet-4-5).
AI_MODEL=

# Provider API key. Server-side only — it is never sent to the mobile app.
AI_API_KEY=

# Optional: override the provider base URL (Azure OpenAI, a gateway, a proxy).
# AI_BASE_URL=https://api.openai.com/v1

# Speech-to-text model used by POST /api/transcribe (OpenAI provider only).
AI_TRANSCRIBE_MODEL=whisper-1

# Abort an upstream AI call after this many milliseconds.
AI_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# Trust X-Forwarded-For — keep 1/true behind a reverse proxy (Coolify, Nginx,
# Traefik) so rate limiting sees the real client IP.
TRUST_PROXY=true

# ---------------------------------------------------------------------------
# Limits and security
# ---------------------------------------------------------------------------
MAX_TEXT_LENGTH=5000
MAX_AUDIO_BYTES=10485760
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# "*" for development. In production list the allowed origins, comma separated.
CORS_ORIGIN=*
