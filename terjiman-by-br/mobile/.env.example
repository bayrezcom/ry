# Base URL of the Terjiman backend. This is the ONLY server value the mobile
# app knows about — AI provider keys live exclusively on the backend.
#
# Local development (iOS simulator / Android emulator on the same machine):
#   EXPO_PUBLIC_API_URL=http://localhost:3000
# Physical device on the same Wi-Fi — use your computer's LAN IP:
#   EXPO_PUBLIC_API_URL=http://192.168.1.20:3000
# Production:
#   EXPO_PUBLIC_API_URL=https://api.your-domain.com
EXPO_PUBLIC_API_URL=http://localhost:3000
