{
  "expo": {
    "name": "Terjiman by BR",
    "slug": "terjiman-by-br",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "terjiman",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#4A2461",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bayrez.terjiman",
      "infoPlist": {
        "CFBundleDisplayName": "تەرجىمان by BR",
        "NSMicrophoneUsageDescription": "Terjiman uses the microphone only while you are recording speech to translate. Recordings are sent for transcription and are not stored.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bayrez.terjiman",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#4A2461",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundImage": "./assets/android-icon-background.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#4A2461",
          "dark": {
            "backgroundColor": "#100C15"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Terjiman uses the microphone only while you are recording speech to translate."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
